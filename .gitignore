# --- Real/private data: never publish accidentally ---
# uploads/ is a runtime scratch folder that accumulates whatever the user
# drags into the app (including real, possibly-unpublished lab data). It is
# NOT example data and must never be committed.
uploads/
# example_data/ ships only the synthetic_*.xy files generated by
# generate_examples.py. Any real lab file (e.g. CH0*_ND_L.txt, *.png) that
# ended up in there during development must not be committed either.
example_data/CH*
example_data/*.png

# --- Python / venv ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# --- Streamlit / app runtime ---
.streamlit/secrets.toml
braggsview_server.log
*.log

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Test / CI artifacts ---
.pytest_cache/
.coverage
htmlcov/
